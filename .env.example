# ==============================================================================
# .env.example — GIO Motorcycle AI Environment Configuration Template
# ==============================================================================
# File ini merupakan template dokumentasi konfigurasi environment.
# Aplikasi TIDAK otomatis memuat file .env ini saat production;
# pada Railway, variabel harus dikonfigurasi melalui Service Settings / Variables tab.
# JANGAN memasukkan secret, password, atau credential riil ke file ini.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Frontend (Streamlit Dashboard Service)
# ------------------------------------------------------------------------------
# [WAJIB DI PRODUCTION] URL dasar backend FastAPI yang dapat dijangkau oleh dashboard.
# - Mode Lokal: http://127.0.0.1:8000
# - Mode Railway (Private Networking): http://${{gio-inference.RAILWAY_PRIVATE_DOMAIN}}:${{gio-inference.PORT}}
# - Mode Railway (Public URL): https://gio-api-production.up.railway.app
INFERENCE_API_URL=http://127.0.0.1:8000

# [OTOMATIS DI RAILWAY] Port HTTP untuk Streamlit server.
# Disediakan secara otomatis oleh platform Railway saat kontainer berjalan.
# Default lokal: 8501
PORT=8501


# ------------------------------------------------------------------------------
# 2. Konfigurasi Backend (FastAPI Inference Service)
# ------------------------------------------------------------------------------
# [OPSIONAL] Lokasi file checkpoint YOLO26m yang digunakan untuk inferensi.
# Di dalam kontainer Docker, nilainya adalah /app/artifacts/yolo26m_candidate.pt.
# Default lokal: ./artifacts/yolo26m_candidate.pt
MODEL_PATH=/app/artifacts/yolo26m_candidate.pt

# [OPSIONAL] Batas ukuran maksimum unggahan citra dalam megabytes (MB).
# Harus selaras dengan batas maxUploadSize di .streamlit/config.toml (10 MB).
# Default: 10
MAX_UPLOAD_MB=10

# [OPSIONAL] Daftar origin yang diizinkan untuk CORS (pisahkan dengan koma).
# Di production, batasi ke domain publik Streamlit dan Vercel.
# Default: *
ALLOWED_ORIGINS=*
